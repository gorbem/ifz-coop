<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build:
      dotnet build -c Release -p:GameDir="C:\Program Files (x86)\Steam\steamapps\common\Infection Free Zone"

    GameDir must point at the game root (the folder with "Infection Free Zone.exe").
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>EconomyConfigBridge</AssemblyName>
    <RootNamespace>EconomyConfigBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\game</GameDir>
    <ManagedDir>$(GameDir)\Infection Free Zone_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ifz"><HintPath>$(ManagedDir)\Ifz.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Zenject"><HintPath>$(ManagedDir)\Zenject.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JutsuGamesConfig"><HintPath>$(ManagedDir)\JutsuGamesConfig.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
